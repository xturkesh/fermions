import DFL.Transfer

/-!
# Zariski density of the transfer-matrix group (paper: Proposition `prop:nocritical`(iii))

For `λ ≠ 0` the group generated by the two transfer matrices `T_E(±λ) = [[E ∓ λ, -1], [1, 0]]` is Zariski dense
in `SL(2, ℝ)`: every polynomial in the four matrix entries that vanishes on the group vanishes on all of
`SL(2, ℝ)` (`transfer_zariski_dense`).

The proof is elementary (no Lie theory). Let `Z ⊆ SL(2, ℝ)` be the set where every polynomial vanishing on the
group `Γ` vanishes. `Z` contains `Γ` and is closed under products (if `z' ∈ Z`, then `φ(· z')` vanishes on
`Γ`). It contains every `U(t) = [[1, t], [0, 1]]`: `t ↦ φ(U(t))` is a polynomial vanishing on `-2λℤ`, because
`T_E(λ) T_E(-λ)⁻¹ = U(-2λ)`. It contains every lower unipotent `L(s) = [[1, 0], [s, 1]]`, since
`T_E(λ) = U(c) W` with `c = E - λ` and `W = [[0, -1], [1, 0]]`, so that `L(-s) = U(-c) T_E(λ) U(s) T_E(λ)⁻¹ U(c)`.
Finally the unipotents generate `SL(2, ℝ)`.
-/

open Matrix

noncomputable section

namespace DFL

/-- The transfer matrix `T_E(v)` as an element of `SL(2, ℝ)`. -/
def transferSL (E v : ℝ) : Matrix.SpecialLinearGroup (Fin 2) ℝ :=
  ⟨transferT E v, by simp [transferT, Matrix.det_fin_two]⟩

/-- Evaluation of a polynomial in the four matrix entries at a `2 × 2` matrix. -/
def evalEntries (φ : MvPolynomial (Fin 2 × Fin 2) ℝ) (g : Matrix (Fin 2) (Fin 2) ℝ) : ℝ :=
  MvPolynomial.eval (fun ij => g ij.1 ij.2) φ

/-- **Zariski density** (paper: Proposition `prop:nocritical`(iii)): a polynomial in the matrix entries that
vanishes on the group generated by `T_E(λ)` and `T_E(-λ)`, `λ ≠ 0`, vanishes on `SL(2, ℝ)`. -/
theorem transfer_zariski_dense (E lam : ℝ) (hlam : lam ≠ 0) (φ : MvPolynomial (Fin 2 × Fin 2) ℝ)
    (hφ : ∀ g ∈ Subgroup.closure
      ({transferSL E lam, transferSL E (-lam)} : Set (Matrix.SpecialLinearGroup (Fin 2) ℝ)),
        evalEntries φ g = 0)
    (g : Matrix.SpecialLinearGroup (Fin 2) ℝ) : evalEntries φ g = 0 := by
  sorry

end DFL
