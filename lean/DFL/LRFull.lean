import DFL.TransportSharp

/-!
# The sector-averaged zero-velocity Lieb–Robinson bound on the gauge-theory Hilbert space
(paper: Proposition `prop:LR`)

`A(t) = e^{itH} A e^{-itH}` (`heisT`). The observable `B` is *localized in `Y`* (`LocB`): it commutes with every
Gauss operator and with `c̃_y`, `c̃_y†` for `y ∉ Y`; this holds for every `B ∈ 𝔅⁺(Y)` (the algebra generated by
the even monomials in `c̃_y`, `y ∈ Y`, and the `G_k`).

* (a) **Sector-wise bound** (no hypothesis): for a monomial `A = c̃^♯_{x_1} ⋯ c̃^♯_{x_k}`,
  `‖P_q [A(t), B]‖ ≤ 2‖B‖ ∑_i ∑_{y ∈ Y} |U_q(t)_{x_i y}|` (`LR_sector_mono`); for `A = ∑_S a_S γ_S` an expansion
  in ordered Majorana monomials `γ_S` with sites in `X`,
  `‖P_q [A(t), B]‖ ≤ 8 (∑_S |a_S|) ‖B‖ ∑_{x ∈ X, y ∈ Y} |U_q(t)_{xy}|` (`LR_sector_maj`).
* (b) **Sector average** under (EC): `E_q sup_t ‖P_q [A(t), B] P_q‖ ≤ 2‖B‖ ∑_i ∑_{y ∈ Y} F(|x_i - y|)`
  (`LR_avg_mono`), resp. `≤ 8 (∑_S |a_S|) ‖B‖ ∑_{x,y} F(|x-y|)` (`LR_avg_maj`); for every density matrix with
  sector weights `Tr(ρ P_q) ≤ K 2^{-N}`, `|Tr(ρ [A(t), B])| ≤ K` times these bounds (`LR_trace_mono`).
* (c) **The operator norm sees the clean sector**: `‖{c̃_x(t), c̃_y†}‖ = ‖[c̃_x(t), n_y]‖ = max_q |U_q(t)_{xy}|`
  (`norm_dressedAnticomm_eq`, `norm_comm_number_eq`).
-/

open Matrix Finset
open scoped Kronecker Matrix.Norms.L2Operator ComplexOrder

noncomputable section

namespace DFL

variable {N : ℕ}

/-- `A(t) = e^{itH} A e^{-itH}`. -/
def heisT (J h : ℝ) (t : ℝ) (A : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ :=
  (evo (H J h) t)ᴴ * A * evo (H J h) t

/-- `c̃_x` (`b = false`) or `c̃_x†` (`b = true`). -/
def dressedSharp (x : Fin N) (b : Bool) : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ :=
  if b then cplx (dressed x)ᵀ else cplx (dressed x)

/-- The monomial `c̃^♯_{x_1} ⋯ c̃^♯_{x_k}`. -/
def dressedMono (l : List (Fin N × Bool)) : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ :=
  (l.map (fun p => dressedSharp p.1 p.2)).prod

/-- The Majorana operators `γ_{2x-1} = c̃_x + c̃_x†` (`b = false`) and `γ_{2x} = i(c̃_x† - c̃_x)` (`b = true`). -/
def majorana (x : Fin N) (b : Bool) : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ :=
  if b then Complex.I • (cplx (dressed x)ᵀ - cplx (dressed x)) else cplx (dressed x) + cplx (dressed x)ᵀ

/-- The Majorana monomial `γ_S` of a list of Majorana indices. -/
def majMono (l : List (Fin N × Bool)) : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ :=
  (l.map (fun p => majorana p.1 p.2)).prod

/-- `B` is localized in `Y`: gauge invariant and commuting with `c̃_y^♯` for `y ∉ Y`. -/
structure LocB (Y : Finset (Fin N)) (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) : Prop where
  gauge : ∀ k : Fin N, B * cplx (gauss k) = cplx (gauss k) * B
  comm : ∀ y ∉ Y, ∀ b : Bool, B * dressedSharp y b = dressedSharp y b * B

namespace LRFullAux

/-! ### Auxiliary lemmas -/

section Basic

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [Fintype ι] [DecidableEq ι] in
/-- The conjugate transpose of a complexified real matrix is the complexified transpose. -/
lemma cplx_conjTranspose' (A : Matrix ι ι ℝ) : (cplx A)ᴴ = cplx Aᵀ := by
  ext i j
  simp [cplx, conjTranspose_apply]

/-- The identity matrix has operator norm at most one. -/
lemma norm_one_le : ‖(1 : Matrix ι ι ℂ)‖ ≤ 1 := by
  rw [← diagonal_one, l2_opNorm_diagonal]
  exact (pi_norm_le_iff_of_nonneg zero_le_one).mpr fun _ => by simp

/-- An isometry (`Uᴴ U = 1`) has operator norm at most one. -/
lemma norm_le_one_of_isometry (U : Matrix ι ι ℂ) (hU : Uᴴ * U = 1) : ‖U‖ ≤ 1 := by
  have h := l2_opNorm_conjTranspose_mul_self U
  rw [hU] at h
  nlinarith [norm_nonneg U, norm_one_le (ι := ι)]

end Basic

/-- The LGT Hamiltonian is a real symmetric matrix. -/
lemma H_isSymm (J h : ℝ) : (H J h : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℝ).IsSymm := by
  have h1 : (Hdual J h : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℝ).IsSymm := by
    unfold Hdual
    rw [Matrix.IsSymm, blockDiagonal_transpose]
    congr 1
    funext q
    unfold Hsec
    rw [transpose_sub, transpose_smul, transpose_one, (dGamma_isSymm _ (hq_isSymm J h q)).eq]
  have h2 : H J h = (Hdual J h).submatrix (dualEquiv (N := N)).symm dualEquiv.symm := by
    rw [← duality, submatrix_submatrix, Equiv.self_comp_symm, submatrix_id_id]
  rw [h2, Matrix.IsSymm, transpose_submatrix, h1.eq]

/-- `e^{-itH}` is unitary: `U U† = 1`. -/
lemma evo_mul_conjTranspose_H (J h t : ℝ) :
    evo (H J h) t * (evo (H J h) t)ᴴ = (1 : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :=
  evo_unitary' _ (H_isSymm J h) t

/-- `e^{-itH}` is unitary: `U† U = 1`. -/
lemma conjTranspose_mul_evo_H (J h t : ℝ) :
    (evo (H J h) t)ᴴ * evo (H J h) t = (1 : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :=
  evo_unitary _ (H_isSymm J h) t

/-- `‖e^{-itH}‖ ≤ 1`. -/
lemma norm_evo_H_le (J h t : ℝ) : ‖(evo (H J h) t : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)‖ ≤ 1 :=
  norm_le_one_of_isometry _ (conjTranspose_mul_evo_H J h t)

/-- The Heisenberg evolution is multiplicative. -/
lemma heis_mul (J h t : ℝ) (A B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    heisT J h t (A * B) = heisT J h t A * heisT J h t B := by
  unfold heisT
  calc (evo (H J h) t)ᴴ * (A * B) * evo (H J h) t
      = (evo (H J h) t)ᴴ * A * (evo (H J h) t * (evo (H J h) t)ᴴ) * B * evo (H J h) t := by
        rw [evo_mul_conjTranspose_H, Matrix.mul_one]; simp only [Matrix.mul_assoc]
    _ = (evo (H J h) t)ᴴ * A * evo (H J h) t * ((evo (H J h) t)ᴴ * B * evo (H J h) t) := by
        simp only [Matrix.mul_assoc]

/-- `heisT 1 = 1`. -/
lemma heis_one (J h t : ℝ) :
    heisT J h t (1 : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) = 1 := by
  unfold heisT
  rw [Matrix.mul_one, conjTranspose_mul_evo_H]

/-- The Heisenberg evolution is additive. -/
lemma heis_add (J h t : ℝ) (A B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    heisT J h t (A + B) = heisT J h t A + heisT J h t B := by
  unfold heisT
  rw [Matrix.mul_add, Matrix.add_mul]

/-- The Heisenberg evolution commutes with subtraction. -/
lemma heis_sub (J h t : ℝ) (A B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    heisT J h t (A - B) = heisT J h t A - heisT J h t B := by
  unfold heisT
  rw [Matrix.mul_sub, Matrix.sub_mul]

/-- The Heisenberg evolution is homogeneous. -/
lemma heis_smul (J h t : ℝ) (c : ℂ) (A : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    heisT J h t (c • A) = c • heisT J h t A := by
  unfold heisT
  rw [Matrix.mul_smul, Matrix.smul_mul]

/-- The Heisenberg evolution commutes with finite sums. -/
lemma heis_sum {κ : Type*} (J h t : ℝ) (s : Finset κ)
    (A : κ → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    heisT J h t (∑ i ∈ s, A i) = ∑ i ∈ s, heisT J h t (A i) := by
  unfold heisT
  rw [Matrix.mul_sum, Matrix.sum_mul]

/-- The Heisenberg evolution of a list product. -/
lemma heis_list_prod {α : Type*} (J h t : ℝ) (f : α → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (l : List α) : heisT J h t (l.map f).prod = (l.map (fun p => heisT J h t (f p))).prod := by
  induction l with
  | nil => simp [heis_one]
  | cons p l ih => rw [List.map_cons, List.prod_cons, heis_mul, ih, List.map_cons, List.prod_cons]

/-- The Heisenberg evolution commutes with the adjoint. -/
lemma heis_conjTranspose (J h t : ℝ) (A : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    heisT J h t Aᴴ = (heisT J h t A)ᴴ := by
  unfold heisT
  rw [conjTranspose_mul, conjTranspose_mul, conjTranspose_conjTranspose, Matrix.mul_assoc]

/-- The Heisenberg evolution does not increase the norm. -/
lemma norm_heis_le (J h t : ℝ) (A : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    ‖heisT J h t A‖ ≤ ‖A‖ := by
  unfold heisT
  have h1 := norm_evo_H_le (N := N) J h t
  have h2 : ‖(evo (H (N := N) J h) t)ᴴ‖ ≤ 1 := by rw [l2_opNorm_conjTranspose]; exact h1
  calc ‖(evo (H J h) t)ᴴ * A * evo (H J h) t‖
      ≤ ‖(evo (H J h) t)ᴴ‖ * ‖A‖ * ‖evo (H J h) t‖ :=
        (norm_mul_le _ _).trans (mul_le_mul_of_nonneg_right (norm_mul_le _ _) (norm_nonneg _))
    _ ≤ 1 * ‖A‖ * 1 := by gcongr
    _ = ‖A‖ := by ring

/-- `‖P_q‖ ≤ 1`. -/
lemma norm_cplx_gaussProj_le (q : Cfg N) : ‖cplx (gaussProj q)‖ ≤ 1 := by
  rw [SectorNormAux.cplx_gaussProj, l2_opNorm_diagonal]
  refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr fun p => ?_
  split_ifs <;> simp

/-- `c̃_y† c̃_y = n_y ⊗ 1` is diagonal with entries `n_y ∈ {0, 1}` (complexified). -/
lemma cplx_number_eq (y : Fin N) :
    cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) =
      diagonal (fun p : Cfg N × Cfg N => ((occ (p.1 y) : ℝ) : ℂ)) := by
  rw [numOp, sec_diagonal_kronecker_one, sec_cplx_diagonal]
  congr 1
  funext p
  simp [count]

/-- `c̃_y† c̃_y = n_y ⊗ 1` (complexified). -/
lemma cplx_dressed_number (y : Fin N) :
    cplx (dressed y)ᵀ * cplx (dressed y) = cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) := by
  rw [← TransportSharpAux.cplx_mul', dressed_number]

/-- `‖c̃_y‖ ≤ 1`: `c̃_y` is a partial isometry. -/
lemma norm_cplx_dressed_le (y : Fin N) : ‖cplx (dressed y)‖ ≤ 1 := by
  have h2 : ‖(cplx (dressed y))ᴴ * cplx (dressed y)‖ ≤ 1 := by
    rw [cplx_conjTranspose', cplx_dressed_number, cplx_number_eq, l2_opNorm_diagonal]
    refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr fun p => ?_
    unfold occ
    split_ifs <;> simp
  rw [l2_opNorm_conjTranspose_mul_self] at h2
  nlinarith [norm_nonneg (cplx (dressed y))]

/-- `‖c̃_y†‖ ≤ 1`. -/
lemma norm_cplx_dressed_transpose_le (y : Fin N) : ‖cplx (dressed y)ᵀ‖ ≤ 1 := by
  rw [← cplx_conjTranspose', l2_opNorm_conjTranspose]
  exact norm_cplx_dressed_le y

/-- `‖c̃^♯_y‖ ≤ 1`. -/
lemma norm_dressedSharp_le (y : Fin N) (b : Bool) : ‖dressedSharp y b‖ ≤ 1 := by
  cases b
  · exact norm_cplx_dressed_le y
  · exact norm_cplx_dressed_transpose_le y

/-! #### Sector projections -/

/-- `P_q P_{q'} = δ_{qq'} P_q` (complexified). -/
lemma cplx_gaussProj_mul (q q' : Cfg N) :
    cplx (gaussProj q) * cplx (gaussProj q') = if q = q' then cplx (gaussProj q) else 0 := by
  rw [← TransportSharpAux.cplx_mul', gaussProj_mul]
  split_ifs
  · rfl
  · exact TransportSharpAux.cplx_zero'

/-- A gauge-invariant operator commutes with every sector projection. -/
lemma comm_gaussProj_of_gaugeInv (M : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hM : GaugeInv M)
    (q : Cfg N) : cplx (gaussProj q) * M = M * cplx (gaussProj q) := by
  ext a b
  rw [SectorNormAux.cplx_gaussProj, diagonal_mul, mul_diagonal]
  by_cases hab : chargeOf a.1 a.2 = chargeOf b.1 b.2
  · simp only [hab]
    ring
  · rw [SectorNormAux.gaugeInv_apply_eq_zero M hM a b hab]
    ring

/-- The complexified Gauss operator is a linear combination of the sector projections. -/
lemma cplx_gauss_eq_sum (j : Fin N) :
    cplx (gauss j) = ∑ q : Cfg N, ((sgn (q j) : ℝ) : ℂ) • cplx (gaussProj q) := by
  rw [SectorNormAux.sum_smul_gaussProj, GaussLawAux.gauss_eq, sec_cplx_diagonal]

/-- An operator commuting with every sector projection is gauge invariant. -/
lemma gaugeInv_of_comm_gaussProj (M : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (hM : ∀ q, cplx (gaussProj q) * M = M * cplx (gaussProj q)) : GaugeInv M := by
  intro j
  rw [cplx_gauss_eq_sum, Matrix.mul_sum, Matrix.sum_mul]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [Matrix.mul_smul, Matrix.smul_mul, hM q]

/-- `c̃_y` is gauge invariant (complexified). -/
lemma gaugeInv_cplx_dressed (y : Fin N) : GaugeInv (cplx (dressed y)) := by
  intro j
  rw [← TransportSharpAux.cplx_mul', ← TransportSharpAux.cplx_mul', dressed_comm_gauss]

/-- `c̃_y†` is gauge invariant (complexified). -/
lemma gaugeInv_cplx_dressed_transpose (y : Fin N) : GaugeInv (cplx (dressed y)ᵀ) := by
  intro j
  rw [← TransportSharpAux.cplx_mul', ← TransportSharpAux.cplx_mul',
    TransportSharpAux.dressed_transpose_comm_gauss]

/-- `P_q` commutes with `c̃^♯_y`. -/
lemma comm_gaussProj_dressedSharp (q : Cfg N) (y : Fin N) (b : Bool) :
    cplx (gaussProj q) * dressedSharp y b = dressedSharp y b * cplx (gaussProj q) := by
  cases b
  · exact comm_gaussProj_of_gaugeInv _ (gaugeInv_cplx_dressed y) q
  · exact comm_gaussProj_of_gaugeInv _ (gaugeInv_cplx_dressed_transpose y) q

/-- `P_q` commutes with every linear combination of the `c̃^♯_y` (fixed `♯`). -/
lemma comm_gaussProj_sum_dressedSharp (q : Cfg N) (c : Fin N → ℂ) (b : Bool) :
    cplx (gaussProj q) * ∑ y, c y • dressedSharp y b =
      (∑ y, c y • dressedSharp y b) * cplx (gaussProj q) := by
  rw [Matrix.mul_sum, Matrix.sum_mul]
  refine Finset.sum_congr rfl fun y _ => ?_
  rw [Matrix.mul_smul, Matrix.smul_mul, comm_gaussProj_dressedSharp]

/-- `P_{q₀} ∑_q P_q Y_q = P_{q₀} Y_{q₀}` when every `Y_q` commutes with the sector projections. -/
lemma gaussProj_mul_sectorSum (Y : Cfg N → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (q₀ : Cfg N) :
    cplx (gaussProj q₀) * ∑ q, cplx (gaussProj q) * Y q = cplx (gaussProj q₀) * Y q₀ := by
  rw [Matrix.mul_sum]
  simp_rw [← Matrix.mul_assoc, cplx_gaussProj_mul, ite_mul, zero_mul]
  rw [Finset.sum_ite_eq]
  simp

/-- `(∑_q P_q Y_q) P_{q₀} = P_{q₀} Y_{q₀}` when every `Y_q` commutes with the sector projections. -/
lemma sectorSum_mul_gaussProj (Y : Cfg N → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (hY : ∀ q q', cplx (gaussProj q') * Y q = Y q * cplx (gaussProj q')) (q₀ : Cfg N) :
    (∑ q, cplx (gaussProj q) * Y q) * cplx (gaussProj q₀) = cplx (gaussProj q₀) * Y q₀ := by
  rw [Matrix.sum_mul]
  have e : ∀ q, cplx (gaussProj q) * Y q * cplx (gaussProj q₀) =
      cplx (gaussProj q₀) * cplx (gaussProj q) * Y q := by
    intro q
    rw [Matrix.mul_assoc, ← hY q q₀, ← Matrix.mul_assoc, cplx_gaussProj_mul, cplx_gaussProj_mul]
    split_ifs with h1 h2 h2
    · subst h1; rfl
    · exact absurd h1.symm h2
    · exact absurd h2.symm h1
    · rfl
  simp_rw [e, cplx_gaussProj_mul, ite_mul, zero_mul]
  rw [Finset.sum_ite_eq]
  simp

/-- The adjoint of a sector sum, multiplied by `P_{q₀}` on the left. -/
lemma gaussProj_mul_sectorSum_conjTranspose (Y : Cfg N → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (hY : ∀ q q', cplx (gaussProj q') * Y q = Y q * cplx (gaussProj q')) (q₀ : Cfg N) :
    cplx (gaussProj q₀) * (∑ q, cplx (gaussProj q) * Y q)ᴴ = cplx (gaussProj q₀) * (Y q₀)ᴴ := by
  have h1 := congrArg conjTranspose (sectorSum_mul_gaussProj Y hY q₀)
  rw [conjTranspose_mul, conjTranspose_mul, SectorNormAux.cplx_gaussProj_conjTranspose] at h1
  rw [h1]
  have h2 := congrArg conjTranspose (hY q₀ q₀)
  rw [conjTranspose_mul, conjTranspose_mul, SectorNormAux.cplx_gaussProj_conjTranspose] at h2
  exact h2

/-- The adjoint of a sector sum, multiplied by `P_{q₀}` on the right. -/
lemma sectorSum_conjTranspose_mul_gaussProj
    (Y : Cfg N → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (hY : ∀ q q', cplx (gaussProj q') * Y q = Y q * cplx (gaussProj q')) (q₀ : Cfg N) :
    (∑ q, cplx (gaussProj q) * Y q)ᴴ * cplx (gaussProj q₀) = cplx (gaussProj q₀) * (Y q₀)ᴴ := by
  have h1 := congrArg conjTranspose (gaussProj_mul_sectorSum Y q₀)
  rw [conjTranspose_mul, conjTranspose_mul, SectorNormAux.cplx_gaussProj_conjTranspose] at h1
  rw [h1]
  have h2 := congrArg conjTranspose (hY q₀ q₀)
  rw [conjTranspose_mul, conjTranspose_mul, SectorNormAux.cplx_gaussProj_conjTranspose] at h2
  exact h2

/-! #### The evolved dressed fermions in a sector -/

/-- Coefficient of `c̃^♯_y` in `P_q c̃^♯_x(t)`: `U_q(t)_{xy}` or its complex conjugate. -/
def coef (J h : ℝ) (q : Cfg N) (t : ℝ) (x y : Fin N) (b : Bool) : ℂ :=
  if b then star (evo (hq J h q) t x y) else evo (hq J h q) t x y

/-- `|coef| = |U_q(t)_{xy}|`. -/
lemma norm_coef (J h : ℝ) (q : Cfg N) (t : ℝ) (x y : Fin N) (b : Bool) :
    ‖coef J h q t x y b‖ = ‖evo (hq J h q) t x y‖ := by
  cases b
  · rfl
  · exact norm_star _

/-- The sector operators `∑_y U_q(t)_{xy} c̃_y` commute with every sector projection. -/
lemma sectorOp_comm (J h t : ℝ) (x : Fin N) (q q' : Cfg N) :
    cplx (gaussProj q') * ∑ y, evo (hq J h q) t x y • cplx (dressed y) =
      (∑ y, evo (hq J h q) t x y • cplx (dressed y)) * cplx (gaussProj q') :=
  comm_gaussProj_sum_dressedSharp q' (fun y => evo (hq J h q) t x y) false

/-- **The evolved `c̃^♯_x` in the sector `q`**: `P_q c̃^♯_x(t) = c̃^♯_x(t) P_q = P_q ∑_y coef_y c̃^♯_y`. -/
lemma gaussProj_heis_dressedSharp (J h : ℝ) (q : Cfg N) (t : ℝ) (x : Fin N) (b : Bool) :
    cplx (gaussProj q) * heisT J h t (dressedSharp x b) =
        cplx (gaussProj q) * ∑ y, coef J h q t x y b • dressedSharp y b ∧
      heisT J h t (dressedSharp x b) * cplx (gaussProj q) =
        cplx (gaussProj q) * ∑ y, coef J h q t x y b • dressedSharp y b := by
  have hX : heisT J h t (cplx (dressed x)) =
      ∑ q, cplx (gaussProj q) * ∑ y, evo (hq J h q) t x y • cplx (dressed y) :=
    heisenberg_dressed J h x t
  cases b
  · refine ⟨?_, ?_⟩
    · show cplx (gaussProj q) * heisT J h t (cplx (dressed x)) = _
      rw [hX, gaussProj_mul_sectorSum]
      rfl
    · show heisT J h t (cplx (dressed x)) * cplx (gaussProj q) = _
      rw [hX, sectorSum_mul_gaussProj _ (sectorOp_comm J h t x)]
      rfl
  · have hadj : heisT J h t (cplx (dressed x)ᵀ) =
        (∑ q, cplx (gaussProj q) * ∑ y, evo (hq J h q) t x y • cplx (dressed y))ᴴ := by
      rw [← cplx_conjTranspose', heis_conjTranspose, hX]
    have hS : (∑ y, evo (hq J h q) t x y • cplx (dressed y))ᴴ =
        ∑ y, coef J h q t x y true • dressedSharp y true := by
      rw [conjTranspose_sum]
      refine Finset.sum_congr rfl fun y _ => ?_
      rw [conjTranspose_smul, cplx_conjTranspose']
      rfl
    refine ⟨?_, ?_⟩
    · show cplx (gaussProj q) * heisT J h t (cplx (dressed x)ᵀ) = _
      rw [hadj, gaussProj_mul_sectorSum_conjTranspose _ (sectorOp_comm J h t x), hS]
    · show heisT J h t (cplx (dressed x)ᵀ) * cplx (gaussProj q) = _
      rw [hadj, sectorSum_conjTranspose_mul_gaussProj _ (sectorOp_comm J h t x), hS]

/-- `P_q` commutes with `c̃^♯_x(t)`. -/
lemma comm_gaussProj_heis_dressedSharp (J h : ℝ) (q : Cfg N) (t : ℝ) (x : Fin N) (b : Bool) :
    cplx (gaussProj q) * heisT J h t (dressedSharp x b) =
      heisT J h t (dressedSharp x b) * cplx (gaussProj q) := by
  rw [(gaussProj_heis_dressedSharp J h q t x b).1, (gaussProj_heis_dressedSharp J h q t x b).2]

/-- `‖[c̃^♯_y, B]‖ ≤ 2‖B‖`. -/
lemma norm_comm_dressedSharp_le (y : Fin N) (b : Bool)
    (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) :
    ‖dressedSharp y b * B - B * dressedSharp y b‖ ≤ 2 * ‖B‖ := by
  have h1 : ‖dressedSharp y b * B‖ ≤ ‖B‖ :=
    (norm_mul_le _ _).trans (mul_le_of_le_one_left (norm_nonneg B) (norm_dressedSharp_le y b))
  have h2 : ‖B * dressedSharp y b‖ ≤ ‖B‖ :=
    (norm_mul_le _ _).trans (mul_le_of_le_one_right (norm_nonneg B) (norm_dressedSharp_le y b))
  linarith [norm_sub_le (dressedSharp y b * B) (B * dressedSharp y b)]

/-- **Sector-wise commutator bound for one evolved dressed fermion**:
`‖P_q [c̃^♯_x(t), B]‖ ≤ 2‖B‖ ∑_{y ∈ Y} |U_q(t)_{xy}|`. -/
lemma norm_gaussProj_comm_heis_dressedSharp_le (J h : ℝ) (Y : Finset (Fin N))
    (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B) (q : Cfg N) (t : ℝ)
    (x : Fin N) (b : Bool) :
    ‖cplx (gaussProj q) * (heisT J h t (dressedSharp x b) * B - B * heisT J h t (dressedSharp x b))‖ ≤
      2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := by
  set P := cplx (gaussProj q) with hP
  set a := heisT J h t (dressedSharp x b) with ha
  set T := ∑ y, coef J h q t x y b • dressedSharp y b with hT
  have hPB : P * B = B * P := comm_gaussProj_of_gaugeInv B hB.gauge q
  have hPa : P * a = P * T := (gaussProj_heis_dressedSharp J h q t x b).1
  have hPT : P * T = T * P := comm_gaussProj_sum_dressedSharp q _ b
  have e1 : P * (a * B - B * a) = P * (T * B - B * T) := by
    have h1 : P * (a * B - B * a) = (P * a) * B - B * (P * a) := by
      rw [Matrix.mul_sub, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hPB, Matrix.mul_assoc B]
    have h2 : P * (T * B - B * T) = (P * T) * B - B * (P * T) := by
      rw [Matrix.mul_sub, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hPB, Matrix.mul_assoc B]
    rw [h1, h2, hPa]
  have e2 : T * B - B * T =
      ∑ y ∈ Y, coef J h q t x y b • (dressedSharp y b * B - B * dressedSharp y b) := by
    rw [hT, Matrix.sum_mul, Matrix.mul_sum, ← Finset.sum_sub_distrib]
    symm
    refine (Finset.sum_subset (Finset.subset_univ Y) (fun y _ hy => ?_)).trans ?_
    · rw [hB.comm y hy b, sub_self, smul_zero]
    · refine Finset.sum_congr rfl fun y _ => ?_
      rw [smul_sub, Matrix.smul_mul, Matrix.mul_smul]
  rw [e1, e2]
  calc ‖P * ∑ y ∈ Y, coef J h q t x y b • (dressedSharp y b * B - B * dressedSharp y b)‖
      ≤ ‖P‖ * ‖∑ y ∈ Y, coef J h q t x y b • (dressedSharp y b * B - B * dressedSharp y b)‖ :=
        norm_mul_le _ _
    _ ≤ 1 * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ * (2 * ‖B‖) := by
        refine mul_le_mul (norm_cplx_gaussProj_le q) ?_ (norm_nonneg _) zero_le_one
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun y _ => ?_)
        rw [norm_smul, norm_coef]
        exact mul_le_mul_of_nonneg_left (norm_comm_dressedSharp_le y b B) (norm_nonneg _)
    _ = 2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := by
        rw [one_mul, Finset.mul_sum]
        exact Finset.sum_congr rfl fun y _ => by ring

/-! #### Leibniz rule -/

/-- A product of factors of norm `≤ 1` has norm `≤ 1`. -/
lemma norm_list_prod_le_one {α : Type*} (f : α → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (hf : ∀ p, ‖f p‖ ≤ 1) (l : List α) : ‖(l.map f).prod‖ ≤ 1 := by
  induction l with
  | nil => simp
  | cons p l ih =>
    rw [List.map_cons, List.prod_cons]
    calc ‖f p * (l.map f).prod‖ ≤ ‖f p‖ * ‖(l.map f).prod‖ := norm_mul_le _ _
      _ ≤ 1 * 1 := mul_le_mul (hf p) ih (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1

/-- **Leibniz rule for commutators with a product**, in norm: if every factor `a_i` has norm `≤ 1`
and commutes with `P`, then `‖P [a_1 ⋯ a_k, B]‖ ≤ ∑_i ‖P [a_i, B]‖`. -/
lemma norm_comm_list_prod_le {α : Type*} (P B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (f : α → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (c : α → ℝ) (hf : ∀ p, ‖f p‖ ≤ 1) (hP : ∀ p, P * f p = f p * P)
    (hc : ∀ p, ‖P * (f p * B - B * f p)‖ ≤ c p) (l : List α) :
    ‖P * ((l.map f).prod * B - B * (l.map f).prod)‖ ≤ (l.map c).sum := by
  induction l with
  | nil => simp
  | cons p l ih =>
    rw [List.map_cons, List.prod_cons, List.map_cons, List.sum_cons]
    set M := (l.map f).prod with hMdef
    have e : P * (f p * M * B - B * (f p * M)) =
        f p * (P * (M * B - B * M)) + P * (f p * B - B * f p) * M := by
      have h1 : f p * (P * (M * B - B * M)) = P * f p * M * B - P * f p * B * M := by
        rw [← Matrix.mul_assoc, ← hP p]
        simp only [Matrix.mul_sub, Matrix.mul_assoc]
      rw [h1]
      simp only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_assoc]
      abel
    rw [e]
    have hM : ‖M‖ ≤ 1 := norm_list_prod_le_one f hf l
    have hcp : 0 ≤ c p := (norm_nonneg _).trans (hc p)
    calc ‖f p * (P * (M * B - B * M)) + P * (f p * B - B * f p) * M‖
        ≤ ‖f p * (P * (M * B - B * M))‖ + ‖P * (f p * B - B * f p) * M‖ := norm_add_le _ _
      _ ≤ ‖f p‖ * ‖P * (M * B - B * M)‖ + ‖P * (f p * B - B * f p)‖ * ‖M‖ :=
          add_le_add (norm_mul_le _ _) (norm_mul_le _ _)
      _ ≤ 1 * (l.map c).sum + c p * 1 :=
          add_le_add (mul_le_mul (hf p) ih (norm_nonneg _) zero_le_one)
            (mul_le_mul (hc p) hM (norm_nonneg _) hcp)
      _ = c p + (l.map c).sum := by ring

/-- A list without repetitions of (site, flag) pairs with sites in `X` visits each site at most
twice: `∑_{p ∈ l} g(p.1) ≤ 2 ∑_{x ∈ X} g(x)` for `g ≥ 0`. -/
lemma list_sum_le_two_mul (l : List (Fin N × Bool)) (X : Finset (Fin N)) (hl : l.Nodup)
    (hX : ∀ p ∈ l, p.1 ∈ X) (g : Fin N → ℝ) (hg : ∀ x, 0 ≤ g x) :
    (l.map (fun p => g p.1)).sum ≤ 2 * ∑ x ∈ X, g x := by
  rw [← List.sum_toFinset _ hl]
  have hsub : l.toFinset ⊆ X ×ˢ (univ : Finset Bool) := by
    intro p hp
    rw [List.mem_toFinset] at hp
    exact Finset.mem_product.mpr ⟨hX p hp, Finset.mem_univ _⟩
  calc ∑ p ∈ l.toFinset, g p.1 ≤ ∑ p ∈ X ×ˢ (univ : Finset Bool), g p.1 :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun p _ _ => hg p.1
    _ = 2 * ∑ x ∈ X, g x := by
        rw [Finset.sum_product, Finset.mul_sum]
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [Fintype.sum_bool]
        ring

/-! #### Majorana operators -/

/-- `c̃_x c̃_x = 0` (complexified). -/
lemma cplx_dressed_mul_self (x : Fin N) : cplx (dressed x) * cplx (dressed x) = 0 := by
  have h := dressed_anticomm x x
  have h2 : dressed x * dressed x = 0 := by
    have h3 : (2 : ℝ) • (dressed x * dressed x) = 0 := by rw [two_smul]; exact h
    exact (smul_eq_zero.mp h3).resolve_left two_ne_zero
  rw [← TransportSharpAux.cplx_mul', h2, TransportSharpAux.cplx_zero']

/-- `c̃_x† c̃_x† = 0` (complexified). -/
lemma cplx_dressed_transpose_mul_self (x : Fin N) :
    cplx (dressed x)ᵀ * cplx (dressed x)ᵀ = 0 := by
  rw [← cplx_conjTranspose', ← conjTranspose_mul, cplx_dressed_mul_self, conjTranspose_zero]

/-- `(c̃_x†)† = c̃_x`. -/
lemma cplx_dressed_transpose_conjTranspose (x : Fin N) :
    (cplx (dressed x)ᵀ)ᴴ = cplx (dressed x) := by
  rw [cplx_conjTranspose', transpose_transpose]

/-- The Majorana operators are self-adjoint unitaries: `γᴴ γ = 1`. -/
lemma majorana_conjTranspose_mul_self (x : Fin N) (b : Bool) :
    (majorana x b)ᴴ * majorana x b = 1 := by
  have hcH : (cplx (dressed x))ᴴ = cplx (dressed x)ᵀ := cplx_conjTranspose' _
  have hdH := cplx_dressed_transpose_conjTranspose x
  have h1 := cplx_dressed_mul_self x
  have h2 := cplx_dressed_transpose_mul_self x
  have h3 : cplx (dressed x) * cplx (dressed x)ᵀ + cplx (dressed x)ᵀ * cplx (dressed x) = 1 := by
    rw [TransportSharpAux.cplx_dressed_CAR]
    simp
  cases b
  · show (cplx (dressed x) + cplx (dressed x)ᵀ)ᴴ * (cplx (dressed x) + cplx (dressed x)ᵀ) = 1
    rw [conjTranspose_add, hcH, hdH, Matrix.add_mul, Matrix.mul_add, Matrix.mul_add, h1, h2, ← h3]
    abel
  · show (Complex.I • (cplx (dressed x)ᵀ - cplx (dressed x)))ᴴ *
        (Complex.I • (cplx (dressed x)ᵀ - cplx (dressed x))) = 1
    have hI : star Complex.I * Complex.I = 1 := by simp [Complex.conj_I]
    rw [conjTranspose_smul, conjTranspose_sub, hcH, hdH, Matrix.smul_mul, Matrix.mul_smul,
      smul_smul, hI, one_smul, Matrix.sub_mul, Matrix.mul_sub, Matrix.mul_sub, h1, h2, ← h3]
    abel

/-- `‖γ‖ ≤ 1`. -/
lemma norm_majorana_le (x : Fin N) (b : Bool) : ‖majorana x b‖ ≤ 1 :=
  norm_le_one_of_isometry _ (majorana_conjTranspose_mul_self x b)

/-- The evolved Majorana operators in terms of the evolved dressed fermions. -/
lemma heis_majorana (J h t : ℝ) (x : Fin N) (b : Bool) :
    heisT J h t (majorana x b) = if b then
      Complex.I • (heisT J h t (dressedSharp x true) - heisT J h t (dressedSharp x false))
      else heisT J h t (dressedSharp x false) + heisT J h t (dressedSharp x true) := by
  cases b
  · exact heis_add J h t _ _
  · show heisT J h t (Complex.I • (cplx (dressed x)ᵀ - cplx (dressed x))) = _
    rw [heis_smul, heis_sub]
    rfl

/-- `P_q` commutes with `γ(t)`. -/
lemma comm_gaussProj_heis_majorana (J h : ℝ) (q : Cfg N) (t : ℝ) (x : Fin N) (b : Bool) :
    cplx (gaussProj q) * heisT J h t (majorana x b) =
      heisT J h t (majorana x b) * cplx (gaussProj q) := by
  have h0 := comm_gaussProj_heis_dressedSharp J h q t x false
  have h1 := comm_gaussProj_heis_dressedSharp J h q t x true
  rw [heis_majorana]
  cases b
  · simp only [Bool.false_eq_true, ite_false]
    rw [Matrix.mul_add, Matrix.add_mul, h0, h1]
  · simp only [ite_true]
    rw [Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_sub, Matrix.sub_mul, h0, h1]

/-- **Sector-wise commutator bound for one evolved Majorana operator**:
`‖P_q [γ(t), B]‖ ≤ 4‖B‖ ∑_{y ∈ Y} |U_q(t)_{xy}|`. -/
lemma norm_gaussProj_comm_heis_majorana_le (J h : ℝ) (Y : Finset (Fin N))
    (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B) (q : Cfg N) (t : ℝ)
    (x : Fin N) (b : Bool) :
    ‖cplx (gaussProj q) * (heisT J h t (majorana x b) * B - B * heisT J h t (majorana x b))‖ ≤
      4 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := by
  have h0 := norm_gaussProj_comm_heis_dressedSharp_le J h Y B hB q t x false
  have h1 := norm_gaussProj_comm_heis_dressedSharp_le J h Y B hB q t x true
  set P := cplx (gaussProj q) with hP
  set a0 := heisT J h t (dressedSharp x false) with ha0
  set a1 := heisT J h t (dressedSharp x true) with ha1
  rw [heis_majorana]
  cases b
  · simp only [Bool.false_eq_true, ite_false]
    have e : P * ((a0 + a1) * B - B * (a0 + a1)) =
        P * (a0 * B - B * a0) + P * (a1 * B - B * a1) := by
      simp only [Matrix.add_mul, Matrix.mul_add, Matrix.mul_sub]
      abel
    rw [e]
    calc ‖P * (a0 * B - B * a0) + P * (a1 * B - B * a1)‖
        ≤ ‖P * (a0 * B - B * a0)‖ + ‖P * (a1 * B - B * a1)‖ := norm_add_le _ _
      _ ≤ 2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ +
          2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := add_le_add h0 h1
      _ = 4 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := by ring
  · simp only [ite_true]
    have e : P * ((Complex.I • (a1 - a0)) * B - B * (Complex.I • (a1 - a0))) =
        Complex.I • (P * (a1 * B - B * a1) - P * (a0 * B - B * a0)) := by
      simp only [Matrix.smul_mul, Matrix.mul_smul, Matrix.sub_mul, Matrix.mul_sub, smul_sub]
      abel
    rw [e, norm_smul, Complex.norm_I, one_mul]
    calc ‖P * (a1 * B - B * a1) - P * (a0 * B - B * a0)‖
        ≤ ‖P * (a1 * B - B * a1)‖ + ‖P * (a0 * B - B * a0)‖ := norm_sub_le _ _
      _ ≤ 2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ +
          2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := add_le_add h1 h0
      _ = 4 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := by ring

/-! #### Products, gauge invariance and averages -/

/-- `P` commutes with a product of factors commuting with `P`. -/
lemma comm_list_prod {α : Type*} (P : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ)
    (f : α → Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hP : ∀ p, P * f p = f p * P)
    (l : List α) : P * (l.map f).prod = (l.map f).prod * P := by
  induction l with
  | nil => simp
  | cons p l ih =>
    rw [List.map_cons, List.prod_cons, ← Matrix.mul_assoc, hP p, Matrix.mul_assoc, ih,
      Matrix.mul_assoc]

/-- `‖P_q X P_q‖ ≤ ‖P_q X‖`. -/
lemma norm_block_le (X : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (q : Cfg N) :
    ‖cplx (gaussProj q) * X * cplx (gaussProj q)‖ ≤ ‖cplx (gaussProj q) * X‖ :=
  (norm_mul_le _ _).trans (mul_le_of_le_one_right (norm_nonneg _) (norm_cplx_gaussProj_le q))

/-- The Bernoulli average of a list sum is the list sum of the averages. -/
lemma avgQ_list_sum {α : Type*} (l : List α) (f : α → Cfg N → ℝ) :
    avgQ (fun q => (l.map (fun p => f p q)).sum) = (l.map (fun p => avgQ (f p))).sum := by
  induction l with
  | nil =>
    simp only [List.map_nil, List.sum_nil]
    exact TransportSharpAux.avgQ_const 0
  | cons p l ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [TransportSharpAux.avgQ_add, ih]

/-- Sector average of the monomial bound under Hypothesis (EC), at a fixed time. -/
lemma avgQ_mono_bound_le (J h : ℝ) {F : ℕ → ℝ} (hEC : EC J h F) (l : List (Fin N × Bool))
    (Y : Finset (Fin N)) (t : ℝ) :
    avgQ (fun q : Cfg N => (l.map (fun p => ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖)).sum) ≤
      (l.map (fun p => ∑ y ∈ Y, F (Nat.dist p.1.val y.val))).sum := by
  rw [avgQ_list_sum l (fun p q => ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖)]
  refine List.sum_le_sum fun p _ => ?_
  rw [TransportSharpAux.avgQ_sum]
  exact Finset.sum_le_sum fun y _ => TransportSharpAux.avgQ_norm_evo_le J h hEC p.1 y t

/-! #### The number operator and `P_q c̃_y` -/

/-- `n_y` commutes with every sector projection (both are diagonal). -/
lemma comm_gaussProj_number (q : Cfg N) (y : Fin N) :
    cplx (gaussProj q) * cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) =
      cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) * cplx (gaussProj q) := by
  rw [cplx_number_eq, SectorNormAux.cplx_gaussProj, diagonal_mul_diagonal, diagonal_mul_diagonal]
  congr 1
  funext p
  ring

/-- `[c̃_z, n_y] = δ_{zy} c̃_y` (complexified). -/
lemma cplx_dressed_comm_number (z y : Fin N) :
    cplx (dressed z) * cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) -
      cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) * cplx (dressed z) =
      if z = y then cplx (dressed y) else 0 := by
  rw [← cplx_dressed_number]
  have h1 := TransportSharpAux.cplx_dressed_CAR z y
  have h2 : cplx (dressed z) * cplx (dressed y) + cplx (dressed y) * cplx (dressed z) = 0 := by
    rw [← TransportSharpAux.cplx_mul', ← TransportSharpAux.cplx_mul',
      ← TransportSharpAux.cplx_add', dressed_anticomm, TransportSharpAux.cplx_zero']
  calc cplx (dressed z) * (cplx (dressed y)ᵀ * cplx (dressed y)) -
        cplx (dressed y)ᵀ * cplx (dressed y) * cplx (dressed z)
      = (cplx (dressed z) * cplx (dressed y)ᵀ + cplx (dressed y)ᵀ * cplx (dressed z)) *
          cplx (dressed y) - cplx (dressed y)ᵀ *
          (cplx (dressed z) * cplx (dressed y) + cplx (dressed y) * cplx (dressed z)) := by
        simp only [Matrix.add_mul, Matrix.mul_add, Matrix.mul_assoc]
        abel
    _ = if z = y then cplx (dressed y) else 0 := by
        rw [h1, h2, Matrix.mul_zero, sub_zero]
        split_ifs <;> simp

/-- **`‖P_q c̃_y‖ = 1`**: `(P_q c̃_y)† (P_q c̃_y) = n_y P_q` is a nonzero diagonal projection. -/
lemma norm_gaussProj_mul_dressed (q : Cfg N) (y : Fin N) :
    ‖cplx (gaussProj q) * cplx (dressed y)‖ = 1 := by
  set v : Cfg N × Cfg N → ℂ := fun p =>
    ((occ (p.1 y) : ℝ) : ℂ) * (if chargeOf p.1 p.2 = q then 1 else 0) with hv
  have hA : (cplx (gaussProj q) * cplx (dressed y))ᴴ * (cplx (gaussProj q) * cplx (dressed y)) =
      diagonal v := by
    rw [conjTranspose_mul, SectorNormAux.cplx_gaussProj_conjTranspose, cplx_conjTranspose',
      Matrix.mul_assoc, ← Matrix.mul_assoc (cplx (gaussProj q)) (cplx (gaussProj q)),
      SectorNormAux.cplx_gaussProj_mul_self]
    have hc : cplx (gaussProj q) * cplx (dressed y) = cplx (dressed y) * cplx (gaussProj q) :=
      comm_gaussProj_dressedSharp q y false
    rw [hc, ← Matrix.mul_assoc, cplx_dressed_number, cplx_number_eq, SectorNormAux.cplx_gaussProj,
      diagonal_mul_diagonal]
  have h1 : ‖(cplx (gaussProj q) * cplx (dressed y))ᴴ * (cplx (gaussProj q) * cplx (dressed y))‖ =
      1 := by
    rw [hA, l2_opNorm_diagonal]
    apply le_antisymm
    · refine (pi_norm_le_iff_of_nonneg zero_le_one).mpr fun p => ?_
      simp only [hv]
      unfold occ
      split_ifs <;> simp
    · set p₀ : Cfg N × Cfg N := (fockCfg {y}, linkOf (fockCfg {y}) q) with hp₀
      have hv₀ : v p₀ = 1 := by
        have e1 : p₀.1 y = 1 := by simp [hp₀, fockCfg]
        have e2 : chargeOf p₀.1 p₀.2 = q := chargeOf_linkOf _ q
        simp only [hv, e1, e2, ite_true, mul_one]
        unfold occ
        have : (1 : ZMod 2) ≠ 0 := by decide
        simp [this]
      calc (1 : ℝ) = ‖v p₀‖ := by rw [hv₀, norm_one]
        _ ≤ ‖v‖ := norm_le_pi_norm v p₀
  rw [l2_opNorm_conjTranspose_mul_self] at h1
  have h0 := norm_nonneg (cplx (gaussProj q) * cplx (dressed y))
  exact le_antisymm (by nlinarith) (by nlinarith)

end LRFullAux

open LRFullAux

/-! ### (a) -/

/-- **Sector-wise Lieb–Robinson bound for monomials** (paper: eq. `eq:main-LRsector`). -/
theorem LR_sector_mono (J h : ℝ) (l : List (Fin N × Bool)) (Y : Finset (Fin N))
    (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B) (q : Cfg N) (t : ℝ) :
    ‖cplx (gaussProj q) * (heisT J h t (dressedMono l) * B - B * heisT J h t (dressedMono l))‖ ≤
      2 * ‖B‖ * (l.map (fun p => ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖)).sum := by
  have hprod : heisT J h t (dressedMono l) =
      (l.map (fun p => heisT J h t (dressedSharp p.1 p.2))).prod := by
    rw [dressedMono, heis_list_prod]
  rw [hprod, ← List.sum_map_mul_left]
  have hf : ∀ p : Fin N × Bool, ‖heisT J h t (dressedSharp p.1 p.2)‖ ≤ 1 := fun p =>
    (norm_heis_le J h t (dressedSharp p.1 p.2)).trans (norm_dressedSharp_le p.1 p.2)
  have hP : ∀ p : Fin N × Bool, cplx (gaussProj q) * heisT J h t (dressedSharp p.1 p.2) =
      heisT J h t (dressedSharp p.1 p.2) * cplx (gaussProj q) := fun p =>
    comm_gaussProj_heis_dressedSharp J h q t p.1 p.2
  have hc : ∀ p : Fin N × Bool, ‖cplx (gaussProj q) * (heisT J h t (dressedSharp p.1 p.2) * B -
      B * heisT J h t (dressedSharp p.1 p.2))‖ ≤ 2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖ :=
    fun p => norm_gaussProj_comm_heis_dressedSharp_le J h Y B hB q t p.1 p.2
  exact norm_comm_list_prod_le (α := Fin N × Bool) (cplx (gaussProj q)) B
    (fun p : Fin N × Bool => heisT J h t (dressedSharp p.1 p.2))
    (fun p : Fin N × Bool => 2 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖) hf hP hc l

/-- **Sector-wise Lieb–Robinson bound for general observables** (paper: Proposition `prop:LR`(a)): for an
expansion `A = ∑_{S ∈ s} a_S γ_S` in Majorana monomials without repeated indices and with sites in `X`. -/
theorem LR_sector_maj (J h : ℝ) (X Y : Finset (Fin N)) (s : Finset (List (Fin N × Bool)))
    (hs : ∀ l ∈ s, l.Nodup ∧ ∀ p ∈ l, p.1 ∈ X) (a : List (Fin N × Bool) → ℂ)
    (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B) (q : Cfg N) (t : ℝ) :
    ‖cplx (gaussProj q) * (heisT J h t (∑ l ∈ s, a l • majMono l) * B -
        B * heisT J h t (∑ l ∈ s, a l • majMono l))‖ ≤
      8 * (∑ l ∈ s, ‖a l‖) * ‖B‖ * ∑ x ∈ X, ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := by
  set P := cplx (gaussProj q) with hP
  have hsum : heisT J h t (∑ l ∈ s, a l • majMono l) = ∑ l ∈ s, a l • heisT J h t (majMono l) := by
    rw [heis_sum]
    exact Finset.sum_congr rfl fun l _ => heis_smul J h t _ _
  rw [hsum]
  have e : P * ((∑ l ∈ s, a l • heisT J h t (majMono l)) * B -
      B * ∑ l ∈ s, a l • heisT J h t (majMono l)) =
      ∑ l ∈ s, a l • (P * (heisT J h t (majMono l) * B - B * heisT J h t (majMono l))) := by
    rw [Matrix.sum_mul, Matrix.mul_sum, ← Finset.sum_sub_distrib, Matrix.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [Matrix.smul_mul, Matrix.mul_smul, ← smul_sub, Matrix.mul_smul]
  rw [e]
  set S := ∑ x ∈ X, ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ with hS
  have hg0 : ∀ x : Fin N, 0 ≤ ∑ y ∈ Y, ‖evo (hq J h q) t x y‖ := fun x =>
    Finset.sum_nonneg fun y _ => norm_nonneg _
  have hf : ∀ p : Fin N × Bool, ‖heisT J h t (majorana p.1 p.2)‖ ≤ 1 := fun p =>
    (norm_heis_le J h t (majorana p.1 p.2)).trans (norm_majorana_le p.1 p.2)
  have hPc : ∀ p : Fin N × Bool, P * heisT J h t (majorana p.1 p.2) =
      heisT J h t (majorana p.1 p.2) * P := fun p =>
    comm_gaussProj_heis_majorana J h q t p.1 p.2
  have hc : ∀ p : Fin N × Bool, ‖P * (heisT J h t (majorana p.1 p.2) * B -
      B * heisT J h t (majorana p.1 p.2))‖ ≤ 4 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖ :=
    fun p => norm_gaussProj_comm_heis_majorana_le J h Y B hB q t p.1 p.2
  have hmono : ∀ l ∈ s, ‖P * (heisT J h t (majMono l) * B - B * heisT J h t (majMono l))‖ ≤
      8 * ‖B‖ * S := by
    intro l hl
    have hprod : heisT J h t (majMono l) =
        (l.map (fun p : Fin N × Bool => heisT J h t (majorana p.1 p.2))).prod := by
      rw [majMono, heis_list_prod]
    rw [hprod]
    refine (norm_comm_list_prod_le (α := Fin N × Bool) P B
      (fun p : Fin N × Bool => heisT J h t (majorana p.1 p.2))
      (fun p : Fin N × Bool => 4 * ‖B‖ * ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖) hf hPc hc l).trans ?_
    rw [List.sum_map_mul_left]
    have h2 := list_sum_le_two_mul l X (hs l hl).1 (hs l hl).2
      (fun x : Fin N => ∑ y ∈ Y, ‖evo (hq J h q) t x y‖) hg0
    calc 4 * ‖B‖ * (l.map (fun p : Fin N × Bool => ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖)).sum
        ≤ 4 * ‖B‖ * (2 * S) := mul_le_mul_of_nonneg_left h2 (by positivity)
      _ = 8 * ‖B‖ * S := by ring
  calc ‖∑ l ∈ s, a l • (P * (heisT J h t (majMono l) * B - B * heisT J h t (majMono l)))‖
      ≤ ∑ l ∈ s, ‖a l‖ * ‖P * (heisT J h t (majMono l) * B - B * heisT J h t (majMono l))‖ :=
        (norm_sum_le _ _).trans (Finset.sum_le_sum fun l _ => norm_smul_le _ _)
    _ ≤ ∑ l ∈ s, ‖a l‖ * (8 * ‖B‖ * S) :=
        Finset.sum_le_sum fun l hl => mul_le_mul_of_nonneg_left (hmono l hl) (norm_nonneg _)
    _ = 8 * (∑ l ∈ s, ‖a l‖) * ‖B‖ * S := by
        rw [← Finset.sum_mul]
        ring

/-! ### (b) -/

/-- **Sector-averaged zero-velocity bound for monomials** (paper: eq. `eq:main-LR`). -/
theorem LR_avg_mono (J h : ℝ) {F : ℕ → ℝ} (hEC : EC J h F) (l : List (Fin N × Bool))
    (Y : Finset (Fin N)) (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B) :
    avgQ (fun q : Cfg N => ⨆ t : ℝ, ‖cplx (gaussProj q) *
        (heisT J h t (dressedMono l) * B - B * heisT J h t (dressedMono l)) * cplx (gaussProj q)‖) ≤
      2 * ‖B‖ * (l.map (fun p => ∑ y ∈ Y, F (Nat.dist p.1.val y.val))).sum := by
  have hpt : ∀ q : Cfg N, (⨆ t : ℝ, ‖cplx (gaussProj q) *
      (heisT J h t (dressedMono l) * B - B * heisT J h t (dressedMono l)) * cplx (gaussProj q)‖) ≤
      2 * ‖B‖ * (l.map (fun p : Fin N × Bool =>
        ∑ y ∈ Y, corrQ (hq J h q) (hq_isHermitian J h q) p.1 y)).sum := by
    intro q
    refine ciSup_le fun t => ?_
    refine (norm_block_le _ q).trans ((LR_sector_mono J h l Y B hB q t).trans ?_)
    refine mul_le_mul_of_nonneg_left (List.sum_le_sum fun p _ => ?_) (by positivity)
    exact Finset.sum_le_sum fun y _ =>
      norm_evo_le_corrQ (hq J h q) (hq_isHermitian J h q) t p.1 y
  refine (TransportSharpAux.avgQ_mono hpt).trans ?_
  rw [TransportSharpAux.avgQ_const_mul]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  rw [avgQ_list_sum l (fun p q => ∑ y ∈ Y, corrQ (hq J h q) (hq_isHermitian J h q) p.1 y)]
  refine List.sum_le_sum fun p _ => ?_
  rw [TransportSharpAux.avgQ_sum]
  exact Finset.sum_le_sum fun y _ => hEC.bound N p.1 y

/-- **Sector-averaged zero-velocity bound for general observables** (paper: eq. `eq:main-LR`). -/
theorem LR_avg_maj (J h : ℝ) {F : ℕ → ℝ} (hEC : EC J h F) (X Y : Finset (Fin N))
    (s : Finset (List (Fin N × Bool))) (hs : ∀ l ∈ s, l.Nodup ∧ ∀ p ∈ l, p.1 ∈ X)
    (a : List (Fin N × Bool) → ℂ) (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B) :
    avgQ (fun q : Cfg N => ⨆ t : ℝ, ‖cplx (gaussProj q) *
        (heisT J h t (∑ l ∈ s, a l • majMono l) * B - B * heisT J h t (∑ l ∈ s, a l • majMono l)) *
          cplx (gaussProj q)‖) ≤
      8 * (∑ l ∈ s, ‖a l‖) * ‖B‖ * ∑ x ∈ X, ∑ y ∈ Y, F (Nat.dist x.val y.val) := by
  have hpt : ∀ q : Cfg N, (⨆ t : ℝ, ‖cplx (gaussProj q) *
      (heisT J h t (∑ l ∈ s, a l • majMono l) * B - B * heisT J h t (∑ l ∈ s, a l • majMono l)) *
        cplx (gaussProj q)‖) ≤
      8 * (∑ l ∈ s, ‖a l‖) * ‖B‖ *
        ∑ x ∈ X, ∑ y ∈ Y, corrQ (hq J h q) (hq_isHermitian J h q) x y := by
    intro q
    refine ciSup_le fun t => ?_
    refine (norm_block_le _ q).trans ((LR_sector_maj J h X Y s hs a B hB q t).trans ?_)
    refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun x _ => Finset.sum_le_sum fun y _ => ?_)
      (by positivity)
    exact norm_evo_le_corrQ (hq J h q) (hq_isHermitian J h q) t x y
  refine (TransportSharpAux.avgQ_mono hpt).trans ?_
  rw [TransportSharpAux.avgQ_const_mul]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  rw [TransportSharpAux.avgQ_sum]
  refine Finset.sum_le_sum fun x _ => ?_
  rw [TransportSharpAux.avgQ_sum]
  exact Finset.sum_le_sum fun y _ => hEC.bound N x y

/-- **Expectations** (paper: Proposition `prop:LR`(b)): for a density matrix with sector weights
`Tr(ρ P_q) ≤ K 2^{-N}`, `|Tr(ρ [A(t), B])| ≤ 2K ‖B‖ ∑_i ∑_{y ∈ Y} F(|x_i - y|)` for every `t`. -/
theorem LR_trace_mono (J h : ℝ) {F : ℕ → ℝ} (hEC : EC J h F) (l : List (Fin N × Bool))
    (Y : Finset (Fin N)) (B : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hB : LocB Y B)
    (ρ : Matrix (Cfg N × Cfg N) (Cfg N × Cfg N) ℂ) (hρ : ρ.PosSemidef) (K : ℝ)
    (hw : ∀ q : Cfg N, (ρ * cplx (gaussProj q)).trace.re ≤ K / 2 ^ N) (t : ℝ) :
    ‖(ρ * (heisT J h t (dressedMono l) * B - B * heisT J h t (dressedMono l))).trace‖ ≤
      K * (2 * ‖B‖ * (l.map (fun p => ∑ y ∈ Y, F (Nat.dist p.1.val y.val))).sum) := by
  set X := heisT J h t (dressedMono l) * B - B * heisT J h t (dressedMono l) with hXdef
  have hprod : heisT J h t (dressedMono l) =
      (l.map (fun p : Fin N × Bool => heisT J h t (dressedSharp p.1 p.2))).prod := by
    rw [dressedMono, heis_list_prod]
  have hPX : ∀ q : Cfg N, cplx (gaussProj q) * X = X * cplx (gaussProj q) := by
    intro q
    have hPa : cplx (gaussProj q) * heisT J h t (dressedMono l) =
        heisT J h t (dressedMono l) * cplx (gaussProj q) := by
      rw [hprod]
      exact comm_list_prod (α := Fin N × Bool) _
        (fun p : Fin N × Bool => heisT J h t (dressedSharp p.1 p.2))
        (fun p => comm_gaussProj_heis_dressedSharp J h q t p.1 p.2) l
    have hPB : cplx (gaussProj q) * B = B * cplx (gaussProj q) :=
      comm_gaussProj_of_gaugeInv B hB.gauge q
    have e1 : cplx (gaussProj q) * X = cplx (gaussProj q) * heisT J h t (dressedMono l) * B -
        cplx (gaussProj q) * B * heisT J h t (dressedMono l) := by
      rw [hXdef, Matrix.mul_sub, ← Matrix.mul_assoc, ← Matrix.mul_assoc]
    have e2 : X * cplx (gaussProj q) = heisT J h t (dressedMono l) * (B * cplx (gaussProj q)) -
        B * (heisT J h t (dressedMono l) * cplx (gaussProj q)) := by
      rw [hXdef, Matrix.sub_mul, Matrix.mul_assoc, Matrix.mul_assoc]
    rw [e1, e2, hPa, hPB, Matrix.mul_assoc (heisT J h t (dressedMono l)) (cplx (gaussProj q)) B,
      Matrix.mul_assoc B (cplx (gaussProj q)) (heisT J h t (dressedMono l)), hPB, hPa]
  have hX : GaugeInv X := gaugeInv_of_comm_gaussProj X hPX
  have hw0 : ∀ q : Cfg N, 0 ≤ (ρ * cplx (gaussProj q)).trace.re := by
    intro q
    have hσ : (cplx (gaussProj q) * ρ * cplx (gaussProj q)).PosSemidef := by
      have := hρ.conjTranspose_mul_mul_same (cplx (gaussProj q))
      rwa [SectorNormAux.cplx_gaussProj_conjTranspose] at this
    have h0 := hσ.trace_nonneg
    rw [SectorNormAux.trace_proj_mul_proj] at h0
    exact (Complex.nonneg_iff.mp h0).1
  have hK : 0 ≤ K := by
    have h := (hw0 0).trans (hw 0)
    rwa [le_div_iff₀ (by positivity), zero_mul] at h
  set g : Cfg N → ℝ := fun q => 2 * ‖B‖ *
    (l.map (fun p : Fin N × Bool => ∑ y ∈ Y, ‖evo (hq J h q) t p.1 y‖)).sum with hg
  have hblock : ∀ q : Cfg N,
      ‖cplx (gaussProj q) * X * cplx (gaussProj q)‖ ≤ g q := fun q =>
    (norm_block_le X q).trans (LR_sector_mono J h l Y B hB q t)
  refine (norm_trace_le ρ X hρ hX).trans ?_
  calc ∑ q : Cfg N, (ρ * cplx (gaussProj q)).trace.re * ‖cplx (gaussProj q) * X * cplx (gaussProj q)‖
      ≤ ∑ q : Cfg N, K / 2 ^ N * g q :=
        Finset.sum_le_sum fun q _ => mul_le_mul (hw q) (hblock q) (norm_nonneg _)
          (div_nonneg hK (by positivity))
    _ = K * avgQ g := by
        rw [avgQ, Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun q _ => ?_
        ring
    _ ≤ K * (2 * ‖B‖ * (l.map (fun p => ∑ y ∈ Y, F (Nat.dist p.1.val y.val))).sum) := by
        refine mul_le_mul_of_nonneg_left ?_ hK
        rw [hg, TransportSharpAux.avgQ_const_mul]
        exact mul_le_mul_of_nonneg_left (avgQ_mono_bound_le J h hEC l Y t) (by positivity)

/-! ### (c) -/

/-- **`‖{c̃_x(t), c̃_y†}‖ = max_q |U_q(t)_{xy}|`** (paper: eq. `eq:main-LRnorm`). -/
theorem norm_dressedAnticomm_eq (J h : ℝ) (x y : Fin N) (t : ℝ) :
    ‖dressedAnticomm J h x y t‖ =
      univ.sup' univ_nonempty (fun q : Cfg N => ‖evo (hq J h q) t x y‖) := by
  have hX : GaugeInv (dressedAnticomm J h x y t) := by
    refine gaugeInv_of_comm_gaussProj _ fun q => ?_
    rw [dressed_anticomm_t, SectorNormAux.sum_smul_gaussProj, SectorNormAux.cplx_gaussProj,
      diagonal_mul_diagonal, diagonal_mul_diagonal]
    congr 1
    funext p
    ring
  rw [norm_gaugeInv _ hX]
  exact Finset.sup'_congr univ_nonempty rfl fun q _ => norm_sector_anticomm J h x y t q

/-- **`‖[c̃_x(t), n_y]‖ = max_q |U_q(t)_{xy}|`** (paper: eq. `eq:main-LRnorm`). -/
theorem norm_comm_number_eq (J h : ℝ) (x y : Fin N) (t : ℝ) :
    ‖heisT J h t (cplx (dressed x)) * cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) -
        cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) * heisT J h t (cplx (dressed x))‖ =
      univ.sup' univ_nonempty (fun q : Cfg N => ‖evo (hq J h q) t x y‖) := by
  have hYcomm : ∀ q q' : Cfg N, cplx (gaussProj q') * (evo (hq J h q) t x y • cplx (dressed y)) =
      (evo (hq J h q) t x y • cplx (dressed y)) * cplx (gaussProj q') := by
    intro q q'
    rw [Matrix.mul_smul, Matrix.smul_mul]
    congr 1
    exact comm_gaussProj_dressedSharp q' y false
  have hZ : heisT J h t (cplx (dressed x)) * cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) -
      cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ)) * heisT J h t (cplx (dressed x)) =
      ∑ q : Cfg N, cplx (gaussProj q) * (evo (hq J h q) t x y • cplx (dressed y)) := by
    have hX : heisT J h t (cplx (dressed x)) =
        ∑ q, cplx (gaussProj q) * ∑ z, evo (hq J h q) t x z • cplx (dressed z) :=
      heisenberg_dressed J h x t
    rw [hX, Matrix.sum_mul, Matrix.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [Matrix.mul_assoc, ← Matrix.mul_assoc (cplx (numOp {y} ⊗ₖ (1 : Matrix (Cfg N) (Cfg N) ℝ))),
      ← comm_gaussProj_number q y, Matrix.mul_assoc, ← Matrix.mul_sub]
    congr 1
    rw [Matrix.sum_mul, Matrix.mul_sum, ← Finset.sum_sub_distrib]
    simp_rw [Matrix.smul_mul, Matrix.mul_smul, ← smul_sub, cplx_dressed_comm_number, smul_ite,
      smul_zero]
    simp only [Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  rw [hZ]
  have hG : GaugeInv (∑ q : Cfg N, cplx (gaussProj q) * (evo (hq J h q) t x y • cplx (dressed y))) :=
    gaugeInv_of_comm_gaussProj _ fun q₀ => by
      rw [gaussProj_mul_sectorSum (fun q => evo (hq J h q) t x y • cplx (dressed y)),
        sectorSum_mul_gaussProj (fun q => evo (hq J h q) t x y • cplx (dressed y)) hYcomm]
  rw [norm_gaugeInv _ hG]
  refine Finset.sup'_congr univ_nonempty rfl fun q _ => ?_
  rw [gaussProj_mul_sectorSum (fun q => evo (hq J h q) t x y • cplx (dressed y)), Matrix.mul_assoc,
    ← hYcomm q q, ← Matrix.mul_assoc, SectorNormAux.cplx_gaussProj_mul_self, Matrix.mul_smul,
    norm_smul, norm_gaussProj_mul_dressed, mul_one]

end DFL
