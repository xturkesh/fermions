import DFL.Evolution

/-!
# Disorder-free localization on arbitrary graphs: exact sector averaging
(paper: Section `sec:2d`, Theorem `thm:2dmap` for `σᶻ`-polarized gauge states)

The ℤ₂ gauge theory of Smith–Knolle–Kovrizhin–Moessner on an arbitrary finite graph (in particular
the two-dimensional square lattice): spinless fermions on the vertices, spins `1/2` on the edges,
`H = -J ∑_e σᶻ_e (c†_{s(e)} c_{t(e)} + h.c.) - h ∑_i ∏_{e ∋ i} σˣ_e` (star terms). In the `σˣ` basis
of the edges, a configuration `(n, x)` has Gauss charges `q = n + ∂x`, where `∂` is the ℤ₂ boundary
map.

For gauge states polarized along `z` (all edges `|↑⟩_z`, a uniform superposition of all edge labels),
the dynamics of every matter observable that is diagonal in the occupations is an exact uniform
average, over the charge configurations `q ∈ n + im ∂`, of free-fermion dynamics generated by
`dΓ(h_q)`, with `h_q = -J A_G + 2h diag(q)` (`A_G` the adjacency matrix, trivial flux). For the
square lattice this is the two-dimensional Anderson model with Bernoulli potential (with the
parity constraint `∏_i q_i = (-1)^{N_f}` coming from `n + im ∂`). The proof uses no gauge fixing:
the fibre uniform superpositions `V|n, q⟩ ∝ ∑_{x : ∂x = q + n} |n, x⟩` intertwine `H` with the
dual free-fermion Hamiltonian.
-/

open Matrix Finset
open scoped Kronecker

noncomputable section

namespace DFL

/-- A finite graph with `N` vertices and `M` oriented edges (multi-edges allowed, no loops). -/
structure FinGraph (N M : ℕ) where
  src : Fin M → Fin N
  tgt : Fin M → Fin N
  src_ne_tgt : ∀ e, src e ≠ tgt e

namespace FinGraph

variable {N M : ℕ} (G : FinGraph N M)

/-- Adjacency matrix (with multiplicities). -/
def adj : Matrix (Fin N) (Fin N) ℝ :=
  fun i j => ((univ.filter (fun e => (G.src e = i ∧ G.tgt e = j) ∨ (G.tgt e = i ∧ G.src e = j))).card : ℝ)

/-- ℤ₂ boundary map: `(∂x)_i = ∑_{e ∋ i} x_e`. -/
def bdry (x : Cfg M) : Cfg N := fun i => ∑ e ∈ univ.filter (fun e => G.src e = i ∨ G.tgt e = i), x e

/-- Hopping along the edge `e`: `c†_{s(e)} c_{t(e)} + c†_{t(e)} c_{s(e)}` (Jordan–Wigner fermions). -/
def hopE (e : Fin M) : Matrix (Cfg N) (Cfg N) ℝ :=
  cre (G.src e) * ann (G.tgt e) + cre (G.tgt e) * ann (G.src e)

/-- `σᶻ` on the edge `e` in the `σˣ` basis: flips the label of `e`. -/
def szE (_G : FinGraph N M) (e : Fin M) : Matrix (Cfg M) (Cfg M) ℝ :=
  fun x' x => if x' = Function.update x e (x e + 1) then 1 else 0

/-- Star term `∏_{e ∋ i} σˣ_e` (diagonal in the `σˣ` basis). -/
def star (i : Fin N) : Matrix (Cfg M) (Cfg M) ℝ := diagonal (fun x => sgn (G.bdry x i))

/-- The ℤ₂ lattice gauge theory Hamiltonian on the graph `G`. -/
def ham (J h : ℝ) : Matrix (Cfg N × Cfg M) (Cfg N × Cfg M) ℝ :=
  (-J) • ∑ e, G.hopE e ⊗ₖ G.szE e - h • ∑ i, (1 : Matrix (Cfg N) (Cfg N) ℝ) ⊗ₖ G.star i

/-- Gauss operator `G_i = (-1)^{n_i} ∏_{e ∋ i} σˣ_e`. -/
def gaussOp (i : Fin N) : Matrix (Cfg N × Cfg M) (Cfg N × Cfg M) ℝ :=
  diagonal (fun p => sgn (p.1 i) * sgn (G.bdry p.2 i))

/-- The one-body Hamiltonian of the charge sector `q`: `h_q = -J A_G + 2h diag(q)`. -/
def hq (J h : ℝ) (q : Cfg N) : Matrix (Fin N) (Fin N) ℝ :=
  (-J) • G.adj + (2 * h) • diagonal (fun i => sgn (q i))

/-- The `z`-polarized gauge state times a matter state `ψ`, in the `σˣ` basis of the edges:
amplitude `2^{-M/2} ψ(n)` for every edge configuration. -/
def initZ (_G : FinGraph N M) (ψ : Cfg N → ℂ) : Cfg N × Cfg M → ℂ :=
  fun p => (((Real.sqrt 2) ^ M : ℝ) : ℂ)⁻¹ * ψ p.1

/-- The charge configurations reachable from the occupation `n`: `n + im ∂`. -/
def sectors (n : Cfg N) : Finset (Cfg N) := univ.image (fun x => n + G.bdry x)

/-- The Gauss operators commute with the Hamiltonian. -/
theorem gaussOp_comm_ham (J h : ℝ) (i : Fin N) :
    G.gaussOp i * G.ham J h = G.ham J h * G.gaussOp i := by
  sorry

/-- `dΓ(h_q)` in terms of the edge hoppings. -/
theorem dGamma_hq (J h : ℝ) (q : Cfg N) :
    dGamma (G.hq J h q) =
      (-J) • ∑ e, G.hopE e + (2 * h) • diagonal (fun n => ∑ i, sgn (q i) * occ (n i)) := by
  sorry

/-- **Exact sector averaging on any graph** (paper: Theorem `thm:2dmap`, `σᶻ`-polarized gauge
states): for Fock matter `|n⟩` and every matter observable `D` diagonal in the occupations, at every
time the LGT expectation is the uniform average over the reachable charge sectors `q ∈ n + im ∂` of
the free-fermion expectations with one-body Hamiltonian `h_q`. -/
theorem sector_average_matter (J h : ℝ) (n : Cfg N) (d : Cfg N → ℝ) (t : ℝ) :
    expect (cplx (diagonal d ⊗ₖ (1 : Matrix (Cfg M) (Cfg M) ℝ)))
        (evo (G.ham J h) t *ᵥ G.initZ (Pi.single n 1)) =
      (1 / ((G.sectors n).card : ℂ)) * ∑ q ∈ G.sectors n,
        expect (cplx (diagonal d)) (evo (dGamma (G.hq J h q)) t *ᵥ Pi.single n 1) := by
  sorry

end FinGraph

end DFL
